# Controller-side settings for run_track_b.sh.
INTERVENTION_HOST=REPLACE_WITH_PRIVATE_VPC_IP
INTERVENTION_USER=root
INTERVENTION_SSH_KEY=/etc/isolation/intervention_harness
INTERVENTION_URL=http://REPLACE_WITH_PRIVATE_VPC_IP:8000/v1
INTERVENTION_METRICS_URL=http://REPLACE_WITH_PRIVATE_VPC_IP:8000/metrics
INTERVENTION_MODEL=Qwen/Qwen3-8B

# Installed on the intervention H100 as /etc/isolation/intervention.env.
# Resolve this once from a versioned tag and paste its immutable digest.
ANTAGONIST_IMAGE=REPLACE_WITH_PINNED_VLLM_IMAGE_DIGEST
NET_IF=eth1
FIO_FILE=/var/lib/isolation-intervention/fio.bin
