[Unit]
Description=MKTG-3390 GPU isolation longitudinal scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/isolation/schedule_track_c.sh
Restart=always
RestartSec=15
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/isolation

[Install]
WantedBy=multi-user.target
