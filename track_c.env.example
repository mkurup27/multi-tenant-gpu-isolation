# Copy to /etc/isolation/track_c.env on the control Droplet and chmod 600.
# Never put the populated copy in this project folder.

H100_HOST=REPLACE_WITH_PRIVATE_VPC_IP
H100_USER=sammy
H100_SSH_KEY=/etc/isolation/isolation_harness
H100_RESULTS_DIR=/home/sammy/isolation-results/track-c

SELF_HOSTED_URL=http://REPLACE_WITH_PRIVATE_VPC_IP:8000/v1
SELF_HOSTED_METRICS_URL=http://REPLACE_WITH_PRIVATE_VPC_IP:8000/metrics
SELF_HOSTED_MODEL=Qwen/Qwen3-8B
SELF_HOSTED_RATE_RPS=2

# Enable a managed arm only after filling every value. Use the exact same
# model/revision and set MANAGED_COMPARISON_GROUP=matched-qwen3-8b only when
# generation controls also match. Otherwise leave within-tier-only.
SERVERLESS_ENABLED=0
SERVERLESS_URL=
SERVERLESS_MODEL=
SERVERLESS_API_KEY=
SERVERLESS_RATE_RPS=2
SERVERLESS_COMPARISON_GROUP=within-tier-only
SERVERLESS_FIXED_OUTPUT_CONFIRMED=0

DEDICATED_ENABLED=0
DEDICATED_URL=
DEDICATED_MODEL=
DEDICATED_API_KEY=
DEDICATED_RATE_RPS=2
DEDICATED_COMPARISON_GROUP=within-tier-only
DEDICATED_FIXED_OUTPUT_CONFIRMED=0

WINDOW_WARMUP_S=30
WINDOW_DURATION_S=120
MAX_OUTSTANDING=64
